{
  "workspaces": {
    "packages/core": {
      "entry": ["src/index.ts", "vitest.config.ts", "tsup.config.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
    },
    "packages/doc-ref": {
      "entry": ["index.ts", "src/cli.ts", "src/index.ts", "vitest.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "*.ts"]
    },
    "packages/openapi": {
      "entry": ["src/index.ts", "tsup.config.ts"],
      "project": ["src/**/*.ts", "*.ts"]
    },
    "packages/playwright": {
      "entry": ["src/index.ts", "vitest.config.ts", "tsup.config.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "*.ts"]
    },
    "packages/registry": {
      "entry": ["index.ts", "src/index.ts", "run-examples.ts", "tsup.config.ts"],
      "project": ["src/**/*.ts", "*.ts"]
    },
    "packages/shared": {
      "entry": ["src/index.ts", "tsup.config.ts"],
      "project": ["src/**/*.ts", "*.ts"]
    },
    "packages/validate": {
      "entry": ["index.ts", "src/validateMarkdownWithSchema.ts", "tsup.config.ts"],
      "project": ["src/**/*.ts", "*.ts"]
    },
    "packages/validation-lib": {
      "entry": ["src/index.ts", "src/cli.ts", "tsup.config.ts"],
      "project": ["src/**/*.ts", "*.ts"]
    }
  },
  "ignore": ["node_modules/**", "dist/**", ".turbo/**", "coverage/**", ".forage/**"]
}
