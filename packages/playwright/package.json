{
  "name": "@fieldtest/playwright",
  "version": "0.1.0",
  "description": "Lightweight AI browser actions with schema-validated observe/plan/act pipeline",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "playwright": "^1.50.0",
    "rimraf": "^5.0.0",
    "tsup": "^7.2.0",
    "typescript": "^5.2.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": ["fieldtest", "playwright", "browser-automation", "ai", "validation", "schema"]
}
