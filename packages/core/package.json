{
	"name": "@fieldtest/core",
	"version": "2.0.0",
	"description": "Validate Markdown documents and data with any Standard Schema: front matter, body outline, and rules.",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist/**/*.js",
		"dist/**/*.mjs",
		"dist/**/*.d.ts",
		"dist/**/*.d.mts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"clean": "rimraf dist",
		"lint": "tsc --noEmit -p .",
		"test": "vitest run"
	},
	"keywords": [
		"validation",
		"typescript",
		"schema",
		"data-pipeline",
		"api-testing",
		"integration-testing",
		"standard-schema",
		"quality-assurance",
		"ci-cd"
	],
	"homepage": "https://docs.matthewhendricks.net",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/watthem/fieldtest.git"
	},
	"bugs": {
		"url": "https://github.com/watthem/fieldtest/issues"
	},
	"author": "Matthew Hendricks <hello@matthewhendricks.net>",
	"license": "MIT",
	"engines": {
		"node": ">=18.3.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@fieldtest/doc-ref": "^1.0.2",
		"@types/node": "^18.17.15",
		"eslint": "^8.49.0",
		"rimraf": "^5.0.0",
		"tsup": "^7.2.0",
		"typescript": "^5.2.2",
		"vitest": "^1.0.0",
		"zod": "^4.1.0",
		"valibot": "^1.1.0"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	}
}
