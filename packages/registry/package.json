{
  "name": "@fieldtest/registry",
  "version": "2.0.0",
  "description": "Ready-made FieldTest checks: Agent Skills (SKILL.md) for the spec and Claude Code, Obsidian Bases metadata. Includes the fieldtest CLI.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "keywords": [
    "fieldtest",
    "markdown",
    "schema",
    "agent-skills",
    "skill-md",
    "claude-code",
    "validation",
    "obsidian"
  ],
  "author": "Matthew Hendricks <hello@matthewhendricks.net>",
  "license": "MIT",
  "homepage": "https://github.com/watthem/fieldtest",
  "repository": {
    "type": "git",
    "url": "https://github.com/watthem/fieldtest.git",
    "directory": "packages/registry"
  },
  "bugs": {
    "url": "https://github.com/watthem/fieldtest/issues"
  },
  "devDependencies": {
    "@types/node": "^18.19.101",
    "eslint": "^8.49.0",
    "tsup": "^7.2.0",
    "typescript": "^5.8.3",
    "vitest": "^0.34.4",
    "zod": "^4.1.0"
  },
  "dependencies": {
    "@fieldtest/core": "workspace:^2.0.0"
  },
  "bin": {
    "fieldtest": "./dist/cli.mjs"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
